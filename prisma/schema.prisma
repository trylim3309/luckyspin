generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  permissions  String[] @default([])
  team         Team     @default(KING88)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customers    Customer[]
}

model User {
  id               String           @id @default(cuid())
  username         String           @unique
  firstName        String
  lastName         String?
  photoUrl         String?
  balance          Float            @default(0)
  isBlocked        Boolean          @default(false)
  isOnline         Boolean          @default(false)
  totalSpins       Int              @default(0)
  totalWins        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  email            String?          @unique
  passwordHash     String
  phone            String?          @unique
  telegramChatId   String?          @unique
  telegramUsername String?
  team             Team             @default(KING88)
  dailySpins       DailySpinCount[]
  spinResults      SpinResult[]
  transactions     SpinTransaction[]
  spinConditionId  String?
  spinCondition    SpinCondition?   @relation(fields: [spinConditionId], references: [id])
  pendingLinks     PendingTelegramLink[]
}

model PendingTelegramLink {
  id               String   @id @default(cuid())
  telegramChatId   String   @unique
  telegramUsername String?
  firstName        String?
  team             Team     @default(KING88)
  linked           Boolean  @default(false)
  linkedAt         DateTime?
  createdAt        DateTime @default(now())
  user             User?   @relation(fields: [userId], references: [id])
  userId           String?
}

model Prize {
  id                  String         @id @default(cuid())
  name                String
  description         String?
  imageUrl            String?
  color               String         @default("#ffffff")
  value               Float          @default(0)
  type                PrizeType      @default(MONEY)
  stock               Int            @default(0)
  unlimitedStock      Boolean        @default(false)
  probability         Float          @default(0)
  minBalanceRequired  Float          @default(0)
  dailyWinLimit       Int            @default(0)
  totalWinLimit       Int            @default(0)
  dailyWinCount       Int            @default(0)
  totalWinCount       Int            @default(0)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  displayOrder        Int            @default(0)
  forcedResultControl ResultControl?
  spinResults         SpinResult[]
}

model SpinCondition {
  id                 String    @id @default(cuid())
  name               String
  spinType           SpinType  @default(FIXED)
  maxSpins           Int       @default(0) // Total spins for FIXED type
  maxSpinsPerDay     Int       @default(10) // Spins per day for DAILY type
  minBalanceRequired Float     @default(0)
  zeroBalanceCanSpin Boolean   @default(false)
  freeSpinEnabled    Boolean   @default(true)
  ipLimitEnabled     Boolean   @default(false)
  deviceLimitEnabled Boolean   @default(false)
  winCooldownMinutes Int       @default(0)
  startDate         DateTime?
  endDate           DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  users             User[]
}

enum SpinType {
  FIXED
  DAILY
}

model ResultControl {
  id                   String      @id @default(cuid())
  mode                 ControlMode @default(RANDOM)
  globalWinPercentage  Float       @default(100)
  globalLosePercentage Float       @default(0)
  forcedPrizeId        String?     @unique
  targetTelegramId     String?
  forceWin             Boolean     @default(false)
  forceLose            Boolean     @default(false)
  blockBigPrize        Boolean     @default(false)
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  prize                Prize?      @relation(fields: [forcedPrizeId], references: [id])
}

model SpinResult {
  id           String       @id @default(cuid())
  userId       String
  prizeId      String?
  isWin        Boolean      @default(false)
  resultSource ResultSource @default(RANDOM)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime     @default(now())
  prize        Prize?       @relation(fields: [prizeId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
}

model CampaignSetting {
  id           String   @id @default(cuid())
  name         String   @unique
  title        String   @default("Lucky Spin")
  subtitle     String?
  isActive     Boolean  @default(true)
  themeColor   String   @default("#FFD700")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  wheelLogoUrl String?
  adminLogoUrl String?
}

model DailySpinCount {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  spinCount Int      @default(0)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model SpinTransaction {
  id        String   @id @default(cuid())
  userId    String
  type      TransactionType
  amount    Int
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Promotion {
  id           String   @id @default(cuid())
  title        String
  description  String?
  remarks      String?
  imageUrl     String?
  type         PromotionType @default(DISCOUNT)
  discount     Float    @default(0) // percentage or fixed amount
  team         Team     @default(KING88)
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(true)
  isClosed     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id         String       @id @default(cuid())
  accountId  String?
  name       String
  phone      String?
  callStatus CallStatus   @default(NOT_CONTACTED)
  result     ResultStatus @default(NOT_CREATED)
  telegramId String?
  remarks    String?
  agentId    String
  team       Team
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  agent      AdminUser    @relation(fields: [agentId], references: [id])

  @@unique([accountId])
  @@index([agentId])
  @@index([result])
  @@index([createdAt])
  @@index([agentId, result])
  @@index([agentId, createdAt])
}

model TelegramContact {
  id           String   @id @default(cuid())
  name         String
  username     String?
  phone        String?
  team         Team
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum CallStatus {
  NOT_CONTACTED
  CALLED
  CHATTED
  NO_ANSWER
  NOT_INTERESTED
}

enum ResultStatus {
  NOT_CREATED
  DEPOSIT
  NOT_DEPOSIT
}

enum PromotionType {
  DISCOUNT
  FREE_SPIN
  CASHBACK
  OTHER
}

enum Team {
  KING88
  SKY24
  B88
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
}

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  TEAM_LEADER
  MANAGER
  VIEWER
}

enum PrizeType {
  MONEY
  COUPON
  PRODUCT
  FREE_SPIN
  EMPTY
  NO_WIN
}

enum ControlMode {
  RANDOM
  ADMIN_CONTROL
  FORCE_WIN
  FORCE_LOSE
  USER_SPECIFIC
}

enum ResultSource {
  RANDOM
  ADMIN_CONTROL
  FORCE_WIN
  FORCE_LOSE
  USER_CONTROLLED
}
